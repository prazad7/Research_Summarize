# Used only when running the backend directly with uvicorn/celery (no
# Docker) -- copy to backend/.env. Requires Postgres and Valkey/Redis
# running locally (e.g. `docker-compose up postgres valkey`).

OPENAI_API_KEY=sk-...
SERPER_API_KEY=...
APP_API_KEY=

ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=postgresql+psycopg2://research_summarize:research_summarize@localhost:5432/research_summarize
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=100
MAX_MEDIA_DURATION_MINUTES=60

ENABLE_OCR_FALLBACK=true
ENABLE_YOUTUBE_AUDIO_FALLBACK=true
TRUNCATE_CONTENT_CHARS=14000

LOG_LEVEL=INFO
LOG_JSON=false

CREWAI_TRACING_ENABLED=false
