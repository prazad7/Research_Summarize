# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored -- never commit real API keys.

# --- Required: LLM & research ------------------------------------------------
OPENAI_API_KEY=sk-...
SERPER_API_KEY=...            # https://serper.dev (free tier available)

# --- Auth ----------------------------------------------------------------------
# Shared access key the frontend must send in the X-API-Key header.
# Leave blank for pure local/no-auth experimentation; set a real value
# before this is reachable from the public internet (e.g. on your VPS).
APP_API_KEY=

# --- App -----------------------------------------------------------------------
ENVIRONMENT=local
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (docker-compose overrides DATABASE_URL itself; these three
# values are what it's built from -- change them here) -----------------------
POSTGRES_USER=research_summarize
POSTGRES_PASSWORD=research_summarize
POSTGRES_DB=research_summarize

# --- Only needed if running the backend WITHOUT docker-compose --------------
# DATABASE_URL=postgresql+psycopg2://research_summarize:research_summarize@localhost:5432/research_summarize
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- File handling -------------------------------------------------------------
MAX_FILE_SIZE_MB=100
MAX_MEDIA_DURATION_MINUTES=60
UPLOAD_DIR=./data/uploads

# --- Ingestion behavior --------------------------------------------------------
ENABLE_OCR_FALLBACK=true
ENABLE_YOUTUBE_AUDIO_FALLBACK=true
TRUNCATE_CONTENT_CHARS=14000

# --- Ports (host side, docker-compose) ------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- CrewAI ------------------------------------------------------------------------
# Explicitly opts out of crewai's first-run tracing/telemetry consent prompt --
# irrelevant (and can print noisy console boxes) in a headless worker process.
CREWAI_TRACING_ENABLED=false
